{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WeeklyReport",
  "description": "reports/weekly.json: what, if anything, to do this week?",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "generated_at": {"$ref": "common.schema.json#/$defs/timestamp"},
    "as_of": {"$ref": "common.schema.json#/$defs/date"},
    "week_of": {"description": "Monday of the week covered.", "$ref": "common.schema.json#/$defs/date"},
    "summary": {"$ref": "common.schema.json#/$defs/text"},
    "actions": {"description": "Empty is a normal answer.", "type": "array", "items": {"$ref": "common.schema.json#/$defs/action"}},
    "changes": {"description": "What changed since last week, in words.", "type": "array", "items": {"$ref": "common.schema.json#/$defs/text"}},
    "disagreements": {
      "description": "Where the panel and the math differ this week.",
      "type": "array",
      "items": {
        "title": "Disagreement",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "symbol": {"$ref": "common.schema.json#/$defs/symbol"},
          "cik": {"$ref": "common.schema.json#/$defs/cik"},
          "math_verdict": {"$ref": "common.schema.json#/$defs/any_verdict"},
          "panel_verdict": {"$ref": "common.schema.json#/$defs/any_verdict"},
          "note": {"$ref": "common.schema.json#/$defs/text"}
        },
        "required": ["symbol", "cik", "math_verdict", "panel_verdict", "note"]
      }
    }
  },
  "required": ["generated_at", "as_of", "week_of", "summary", "actions", "changes", "disagreements"]
}
